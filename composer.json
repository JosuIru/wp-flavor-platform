{
    "name": "gailu/flavor-platform",
    "description": "Flavor Platform para WordPress: comunidades, IA, page builder y automatizacion",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Gailu Labs",
            "homepage": "https://gailu.net"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "10up/wp_mock": "^0.5",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "doctrine/instantiator": "^2.0.0",
        "mockery/mockery": "^1.6",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.10",
        "phpunit/php-code-coverage": "^9.2",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "FlavorPlatform\\": "includes/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress --extensions=php --ignore=vendor,node_modules,tests,dev-scripts .",
        "lint:file": "phpcs --standard=WordPress --extensions=php",
        "lint:fix": "phpcbf --standard=WordPress --extensions=php --ignore=vendor,node_modules,tests,dev-scripts .",
        "lint:compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- --extensions=php --ignore=vendor,node_modules,tests .",
        "test": "phpunit --testsuite unit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit -c tests/phpunit-integration.xml.dist",
        "test:all": [
            "@test:unit",
            "@test:integration"
        ],
        "test:coverage": "XDEBUG_MODE=coverage phpunit --testsuite unit --coverage-html tests/coverage/html --coverage-text=tests/coverage/coverage.txt",
        "test:coverage:unit": "XDEBUG_MODE=coverage phpunit --testsuite unit --coverage-html tests/coverage/html",
        "test:coverage:clover": "XDEBUG_MODE=coverage phpunit --testsuite unit --coverage-clover tests/coverage/clover.xml",
        "test:benchmark": "phpunit -c tests/phpunit-benchmark.xml.dist",
        "test:install": "tools/install-wp-tests.sh wordpress_test root root localhost latest",
        "analyze": "phpstan analyse -c config/phpstan.neon --memory-limit=1G",
        "check": [
            "@lint",
            "@test:unit"
        ],
        "post-install-cmd": [
            "@php -r \"if (!file_exists('vendor/bin/phpcs')) { echo 'Skipping phpcs config (dev deps not installed).' . PHP_EOL; exit; } passthru('vendor/bin/phpcs --config-set installed_paths vendor/wp-coding-standards/wpcs,vendor/phpcompatibility/php-compatibility,vendor/phpcompatibility/phpcompatibility-paragonie,vendor/phpcompatibility/phpcompatibility-wp,vendor/phpcsstandards/phpcsextra,vendor/phpcsstandards/phpcsutils');\""
        ],
        "post-update-cmd": [
            "@php -r \"if (!file_exists('vendor/bin/phpcs')) { echo 'Skipping phpcs config (dev deps not installed).' . PHP_EOL; exit; } passthru('vendor/bin/phpcs --config-set installed_paths vendor/wp-coding-standards/wpcs,vendor/phpcompatibility/php-compatibility,vendor/phpcompatibility/phpcompatibility-paragonie,vendor/phpcompatibility/phpcompatibility-wp,vendor/phpcsstandards/phpcsextra,vendor/phpcsstandards/phpcsutils');\""
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "wordpress-plugin": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
