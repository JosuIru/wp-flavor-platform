<?xml version="1.0"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    verbose="true"
    stopOnFailure="false"
>
    <testsuites>
        <testsuite name="benchmark">
            <directory suffix="Test.php">tests/benchmark</directory>
        </testsuite>
    </testsuites>

    <php>
        <const name="WP_TESTS_MULTISITE" value="0"/>
        <const name="WP_TESTS_DOMAIN" value="localhost"/>
    </php>
</phpunit>
