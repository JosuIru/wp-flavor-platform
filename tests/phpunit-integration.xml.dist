<?xml version="1.0"?>
<!--
    PHPUnit config para tests de INTEGRACIÓN.

    Requiere WordPress Test Framework instalado:
    ./bin/install-wp-tests.sh wordpress_test root root

    Ejecutar con:
    ./vendor/bin/phpunit -c phpunit-integration.xml.dist
-->
<phpunit
    bootstrap="tests/bootstrap-integration.php"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    stopOnFailure="false"
>
    <testsuites>
        <testsuite name="integration">
            <directory suffix="Test.php">tests/integration</directory>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="false">
        <include>
            <directory suffix=".php">includes</directory>
        </include>
        <exclude>
            <directory suffix=".php">tests</directory>
            <directory suffix=".php">vendor</directory>
            <directory suffix=".php">includes/admin/views</directory>
            <directory suffix=".php">includes/views</directory>
            <directory suffix=".php">includes/templates</directory>
        </exclude>
        <report>
            <html outputDirectory="tests/coverage/integration"/>
        </report>
    </coverage>

    <php>
        <const name="WP_TESTS_MULTISITE" value="0"/>
        <env name="WP_TESTS_DIR" value="/tmp/wordpress-tests-lib"/>
    </php>
</phpunit>
